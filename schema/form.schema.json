{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/momentumlab-ch/mlab-forms/schema/form.schema.json",
	"title": "MomentumLab Forms: Formular",
	"description": "Single Source of Truth eines Formulars. Builder, Renderer, Validierung und KI arbeiten auf diesem Schema.",
	"type": "object",
	"required": [ "schema_version", "fields" ],
	"properties": {
		"schema_version": { "const": 1 },
		"title": { "type": "string" },
		"settings": { "$ref": "#/$defs/settings" },
		"fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
	},
	"$defs": {
		"settings": {
			"type": "object",
			"properties": {
				"submit_label": { "type": "string" },
				"success_message": { "type": "string" },
				"redirect_url": { "type": "string", "description": "Danke-Seite nach dem Absenden (optional)." },
				"store_entries": { "type": "boolean", "default": true },
				"retention_days": { "type": "integer", "minimum": 1, "maximum": 3650, "default": 365 },
				"style": { "enum": [ "", "light", "dark" ], "description": "Leer: Farbschema aus den Plugin-Einstellungen." },
				"spam": {
					"type": "object",
					"properties": {
						"honeypot": { "type": "boolean" },
						"min_seconds": { "type": "integer", "minimum": 0, "maximum": 60 },
						"turnstile": { "type": "boolean", "description": "Ab Phase 4." }
					}
				},
				"notifications": { "type": "array", "items": { "$ref": "#/$defs/notification" } },
				"tracking": {
					"type": "object",
					"properties": {
						"ga4_event": { "type": "string" },
						"ga4_params": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Parameter mit Merge-Tags, z. B. {\"angebot\": \"{field:angebot}\"}." }
					}
				}
			}
		},
		"notification": {
			"type": "object",
			"required": [ "to", "subject" ],
			"properties": {
				"id": { "type": "string" },
				"to": { "type": "string", "description": "Adressen, durch Komma getrennt. Merge-Tags wie {site_admin_email} oder {field:email}." },
				"reply_to": { "type": "string", "description": "Nur gültige Adressen aus E-Mail-Feldern oder feste Adressen." },
				"subject": { "type": "string" },
				"body": { "type": "string", "description": "Text mit Merge-Tags, z. B. {all_fields}." },
				"enabled": { "type": "boolean", "default": true }
			}
		},
		"option": {
			"oneOf": [
				{ "type": "string" },
				{
					"type": "object",
					"required": [ "value" ],
					"properties": { "value": { "type": "string" }, "label": { "type": "string" }, "group": { "type": "string" } }
				}
			]
		},
		"field": {
			"type": "object",
			"required": [ "id", "type" ],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
				"type": {
					"enum": [ "text", "email", "tel", "textarea", "number", "select", "radio", "checkbox", "checkbox_group", "date", "hidden", "consent", "heading", "html" ],
					"description": "Weitere Typen über den Filter mlab_forms_field_types."
				},
				"label": { "type": "string" },
				"placeholder": { "type": "string" },
				"help": { "type": "string" },
				"required": { "type": "boolean" },
				"default": { "type": [ "string", "number", "boolean" ] },
				"width": { "enum": [ "full", "half", "third" ] },
				"autocomplete": { "type": "string" },
				"min": { "type": [ "number", "string" ], "description": "Bei date: JJJJ-MM-TT oder today." },
				"max": { "type": [ "number", "string" ] },
				"step": { "type": "number" },
				"pattern": { "type": "string" },
				"rows": { "type": "integer", "minimum": 1 },
				"content": { "type": "string", "description": "HTML für den Typ html." },
				"link": { "type": "string", "description": "Link bei consent, z. B. {privacy_url}." },
				"options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
				"options_source": {
					"type": "object",
					"required": [ "provider" ],
					"properties": {
						"provider": { "type": "string", "description": "Eingebaut: post_type. Weitere über mlab_forms_options_providers." },
						"post_type": { "type": "string" },
						"prepend": { "type": "array", "items": { "$ref": "#/$defs/option" } },
						"groups": { "type": "string", "description": "meta:schlüssel oder taxonomy:name" }
					}
				},
				"prefill": {
					"type": "object",
					"properties": {
						"param": { "type": "string", "description": "URL-Parameter, z. B. ?angebot=…" },
						"data_attribute": { "type": "string", "description": "Links mit diesem Attribut setzen den Wert, z. B. data-anfrage." }
					}
				},
				"conditions": { "type": "array", "description": "Ab Phase 4." }
			}
		}
	}
}
