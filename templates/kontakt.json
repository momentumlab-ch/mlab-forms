{
	"schema_version": 1,
	"title": "Kontakt",
	"settings": {
		"submit_label": "Nachricht senden",
		"success_message": "Danke für deine Nachricht! Wir melden uns bald.",
		"notifications": [
			{ "id": "admin", "to": "{site_admin_email}", "reply_to": "{field:email}", "subject": "Neue Nachricht von {field:name}", "body": "{all_fields}" }
		]
	},
	"fields": [
		{ "id": "name", "type": "text", "label": "Name", "required": true, "autocomplete": "name", "width": "half" },
		{ "id": "email", "type": "email", "label": "E-Mail", "required": true, "autocomplete": "email", "width": "half" },
		{ "id": "nachricht", "type": "textarea", "label": "Nachricht", "required": true, "rows": 5 },
		{ "id": "consent", "type": "consent", "label": "Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage gespeichert werden.", "link": "{privacy_url}", "required": true }
	]
}
