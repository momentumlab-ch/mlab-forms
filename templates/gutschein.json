{
	"schema_version": 1,
	"title": "Gutschein",
	"settings": {
		"submit_label": "Gutschein bestellen",
		"success_message": "Danke für deine Bestellung! Wir senden dir den Gutschein mit Rechnung per E-Mail.",
		"notifications": [
			{ "id": "admin", "to": "{default_recipient}", "reply_to": "{field:email}", "subject": "Gutschein-Bestellung von {field:name}", "body": "{all_fields}" },
			{ "id": "guest", "to": "{field:email}", "subject": "Deine Gutschein-Bestellung bei {site_name}", "body": "Hoi {field:name}\n\nDanke für deine Bestellung. Wir melden uns in Kürze.\n\n{all_fields}\n\nLiebe Grüsse\n{site_name}" }
		]
	},
	"fields": [
		{ "id": "betrag", "type": "select", "label": "Betrag", "required": true, "width": "half",
			"options": [ { "value": "50" , "label": "CHF 50" }, { "value": "100", "label": "CHF 100" }, { "value": "200", "label": "CHF 200" } ] },
		{ "id": "empfaenger", "type": "text", "label": "Für wen ist der Gutschein?", "width": "half" },
		{ "id": "widmung", "type": "textarea", "label": "Widmung", "rows": 3 },
		{ "id": "name", "type": "text", "label": "Dein Name", "required": true, "autocomplete": "name", "width": "half" },
		{ "id": "email", "type": "email", "label": "Deine E-Mail", "required": true, "autocomplete": "email", "width": "half" },
		{ "id": "adresse", "type": "textarea", "label": "Rechnungsadresse", "required": true, "rows": 3, "autocomplete": "street-address" },
		{ "id": "consent", "type": "consent", "label": "Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Bestellung gespeichert werden.", "link": "{privacy_url}", "required": true }
	]
}
