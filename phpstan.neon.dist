includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 6
    paths:
        - inc
        - mlab-forms.php
        - uninstall.php
    scanDirectories:
        - lib/plugin-update-checker
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    ignoreErrors:
        # inc/updater.php folgt der Vorlage: Schalter $private für private Repos, GitHubApi hinter getVcsApi().
        -
            identifiers:
                - booleanAnd.leftAlwaysFalse
                - if.alwaysFalse
                - method.notFound
            path: inc/updater.php
