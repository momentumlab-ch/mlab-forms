#. translators: 1: Name der Sprache, 2: Anzahl Übersetzungen
#: inc/Admin/BuilderTexts.php:214
#, php-format
msgid ""
"Sprache «%1$s» entfernen? Dabei werden %2$d Übersetzungen gelöscht. Danach kannst du das noch kurz rückgängig machen."
msgstr ""
"Supprimer la langue « %1$s » ? %2$d traductions seront alors effacées. Vous pourrez encore annuler brièvement cette action."

#. translators: %s: Name der Sprache
#: inc/Admin/BuilderTexts.php:216
#, php-format
msgid "Sprache «%s» entfernen? Sie hat noch keine Übersetzungen."
msgstr ""
"Supprimer la langue « %s » ? Elle ne contient pas encore de traductions."

