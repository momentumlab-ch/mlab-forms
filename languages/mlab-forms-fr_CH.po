#: inc/options.php:36
msgid ""
"An diese Adresse(n) gehen die Anfragen, wenn ein Formular keine eigene Adresse hat. Mehrere Adressen trennst du mit Komma. Leer lassen für die Admin-E-Mail der Website."
msgstr ""
"Les demandes sont envoyées à ces adresses lorsqu'un formulaire n'a pas d'adresse propre. Séparez plusieurs adresses par une virgule. Laissez vide pour utiliser l'adresse e-mail de l'administrateur du site."

msgid "Datei"
msgstr "Fichier"

msgid "accept muss eine Liste von Dateiendungen sein, z. B. [\"pdf\", \"docx\"]."
msgstr ""
"accept doit être une liste d'extensions de fichier, p. ex. [\"pdf\", \"docx\"]."

msgid "max_size ist die Grösse in MB, höchstens %d."
msgstr "max_size est la taille en Mo, %d au maximum."

msgid "Bitte wähle eine Datei aus."
