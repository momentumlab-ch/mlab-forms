#, php-format
msgid "Standardtext: %s"
msgstr "Texte par défaut : %s"

#. translators: %s: Name der Sprache
#: inc/Admin/BuilderTexts.php:204
#, php-format
msgid "Du übersetzt in %s. Ein leeres Feld zeigt den Standardtext."
msgstr "Vous traduisez en %s. Un champ vide affiche le texte par défaut."

#: inc/Admin/BuilderTexts.php:205
msgid "Dieses Feld hat keine Texte zum Übersetzen."
msgstr "Ce champ ne contient aucun texte à traduire."

#: inc/Admin/BuilderTexts.php:206
msgid ""
"Betreff und Text der E-Mails übersetzt du in der Experten-Ansicht (JSON) bei der Benachrichtigung unter «i18n». E-Mails an die Admin-Adresse erscheinen immer in der Standardsprache."
msgstr ""
"L'objet et le texte des e-mails se traduisent dans la vue experte (JSON), dans la notification, sous « i18n ». Les e-mails envoyés à l'adresse de l'administrateur sont toujours rédigés dans la langue par défaut."

#. translators: %s: Name der Sprache
#: inc/Admin/BuilderTexts.php:208
#, php-format
msgid "Sprache: %s"
msgstr "Langue : %s"

#. translators: %s: Name der Sprache
