msgstr "The language “%s” is not in “languages”."

#. translators: %s: Schlüssel
#: inc/Forms/I18nValidator.php:156
#, php-format
msgid "«%s» kann nicht übersetzt werden."
msgstr "“%s” cannot be translated."

#: inc/Forms/I18nValidator.php:174
