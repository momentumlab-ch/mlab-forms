msgstr "This field has no options."

#. translators: %s: Wert einer Option
#: inc/Forms/I18nValidator.php:187
#, php-format
msgid "Das Feld hat keine Option mit dem Wert «%s»."
msgstr "The field has no option with the value “%s”."

#. translators: %d: höchste Anzahl Sprachen
#: inc/Forms/I18nValidator.php:68
#, php-format
msgid ""
"«languages» muss eine Liste mit 1 bis %d Sprachcodes sein, z. B. [\"de\", \"fr\"]."
msgstr ""
"“languages” must be a list of 1 to %d language codes, e.g. [\"de\", \"fr\"]."

#: inc/Forms/I18nValidator.php:73
msgid "Ein Sprachcode besteht aus zwei oder drei Kleinbuchstaben, z. B. «de»."
msgstr "A language code consists of two or three lowercase letters, e.g. “de”."

#. translators: %s: Sprachcode
