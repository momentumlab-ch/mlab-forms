#: inc/Admin/BuilderTexts.php:196
msgid ""
"Betreff und Text der E-Mails übersetzt du in der Experten-Ansicht (JSON) bei der Benachrichtigung unter «i18n». E-Mails an die Admin-Adresse erscheinen immer in der Standardsprache."
msgstr ""
"You translate the subject and text of emails in the expert view (JSON) at the notification under “i18n”. Emails to the admin address always appear in the default language."

#. translators: %s: Name der Sprache
#: inc/Admin/BuilderTexts.php:198
#, php-format
msgid "Sprache: %s"
msgstr "Language: %s"

#. translators: %s: Name der Sprache
#: inc/Admin/BuilderTexts.php:200
#, php-format
msgid "Sprache «%s» hinzugefügt"
msgstr "Language “%s” added"

#. translators: %s: Name der Sprache
#: inc/Admin/BuilderTexts.php:202
#, php-format
msgid "Sprache «%s» entfernt"
msgstr "Language “%s” removed"

#. translators: 1: Name der Sprache, 2: Anzahl Übersetzungen
#: inc/Admin/BuilderTexts.php:204
#, php-format
msgid ""
"Sprache «%1$s» entfernen? Dabei werden %2$d Übersetzungen gelöscht. Danach kannst du das noch kurz rückgängig machen."
msgstr ""
"Remove language “%1$s”? This deletes %2$d translations. You can still undo it briefly afterwards."

#. translators: %s: Name der Sprache
#: inc/Admin/BuilderTexts.php:206
#, php-format
msgid "Sprache «%s» entfernen? Sie hat noch keine Übersetzungen."
msgstr "Remove language “%s”? It has no translations yet."

